# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Scraped corpora — large, license-sensitive, regenerable from scripts/.
# Italian translations and schedules are whitelisted below.
data/raw/*
!data/raw/translations/
!data/raw/translations/**
# Never commit the dach.dev offline backup (Kehot copyright)
data/raw/_offline/

# Scrape run logs
/tmp/yafutzu-*.log

# Internal outreach drafts — keep private
OUTREACH_*.md
